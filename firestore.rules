rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // StreetClean prototype:
    // Authentication is handled by Firebase Auth. Firestore stores all
    // application data. These rules require a signed-in Firebase user.
    // Tighten role/field-level permissions before production deployment.

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null;

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null;
      }
    }

    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.reportedById == request.auth.uid;
      allow update, delete: if request.auth != null;
    }
  }
}
